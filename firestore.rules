rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // Nama pemilik sesi perangkat ini (hanya ada jika PIN-nya sudah terbukti benar)
    function owner() {
      return get(/databases/$(db)/documents/sessions/$(request.auth.uid)).data.owner;
    }

    // Hash PIN: dibuat sekali saat daftar, tidak bisa dibaca atau diubah siapa pun.
    match /secrets/{n} {
      allow create: if request.auth != null
        && !exists(/databases/$(db)/documents/secrets/$(n))
        && request.resource.data.h is string
        && request.resource.data.h.size() == 64;
    }

    // Sesi: hanya bisa dibuat jika hash PIN cocok. Tidak bisa dibaca klien.
    match /sessions/{uid} {
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['owner', 'h'])
        && request.resource.data.h == get(/databases/$(db)/documents/secrets/$(request.resource.data.owner)).data.h;
    }

    // Profil dan jurnal: semua orang boleh melihat, menulis butuh sesi yang valid.
    match /profiles/{n} {
      allow read: if true;
      allow create: if request.auth != null && owner() == n
        && !exists(/databases/$(db)/documents/profiles/$(n));
    }

    match /entries/{id} {
      allow read: if true;
      allow create: if request.auth != null && owner() == request.resource.data.owner;
      allow update: if request.auth != null && owner() == resource.data.owner
        && request.resource.data.owner == resource.data.owner;
      allow delete: if request.auth != null && owner() == resource.data.owner;
    }
  }
}
